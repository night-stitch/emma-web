# Copier ce fichier en ".env.local" et remplir les valeurs.
# .env.local n'est jamais envoyé sur Git (il est dans .gitignore).

# Clé API Google (Places API New), restreinte au domaine du site
NEXT_PUBLIC_GOOGLE_PLACES_KEY=AIza...

# Identifiant de la fiche Google de La Clé Provençale (commence par ChIJ...)
# À trouver ici : https://developers.google.com/maps/documentation/places/web-service/place-id
NEXT_PUBLIC_GOOGLE_PLACE_ID=ChIJ...

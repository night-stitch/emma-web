rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ Même liste que app/lib/adminAuth.ts et firestore.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'conciergerie@lacleprovencale.fr',
          'alexandre22nadal@gmail.com'
        ];
    }

    // Photos de la page Expérience : lisibles par tous, modifiables par l'admin uniquement.
    match /experiences/{experienceId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Tout le reste est fermé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
